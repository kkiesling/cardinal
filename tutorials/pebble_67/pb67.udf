#ifdef __okl__
#include "pb67.oudf"
#endif

void uservp(double time)
{
  // pass the needed info into the outlet kernel
  mesh_t *mesh = nrs->meshV;
  manipulateOutlet(mesh->Nelements, nrs->fieldOffset, nrs->scalar->fieldOffset(),
               nrs->scalar->o_solution("temperature"), nrs->fluid->o_prop, nrs->scalar->o_prop, mesh->o_z);
}

void UDF_LoadKernels(deviceKernelProperties & kernelInfo)
{
}

void UDF_Setup()
{
  mesh_t * mesh = nrs->meshV;

  // arbitrary arrays on the host where we will fill some initial data
  std::vector<dfloat> U(nrs->fluid->fieldOffsetSum, 0.0);

  // apply initial conditions
  for (int n = 0; n < mesh->Nlocal; ++n)
  {
    U[n + 0 * nrs->fieldOffset] = 0.0; // x-velocity
    U[n + 1 * nrs->fieldOffset] = 0.0; // y-velocity
    U[n + 2 * nrs->fieldOffset] = 1.0; // z-velocity
  }

  // copy host data into the device data
  nrs->fluid->o_U.copyFrom(U.data(), U.size());

  // set the userProperties so that NekRS will modify the diffusive properties
  nrs->userProperties = &uservp;
}

void UDF_ExecuteStep(double time, int tstep)
{
  // clip temperature on each time step
  mesh_t *mesh = nrs->meshV;
  clipTemperature(mesh->Nelements, nrs->scalar->o_solution("temperature"));
}
