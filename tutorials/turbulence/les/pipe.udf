#include "tavg.hpp"

void UDF_LoadKernels(deviceKernelProperties & kernelInfo)
{
}

void userq(double time, occa::memory o_S, occa::memory o_FS)
{
  auto mesh = nrs->meshV;
  dfloat R = 0.5;
  dfloat q_dagger = 1.0;
  periodicSource(mesh->Nelements, nrs->fieldOffset, 2 / R * q_dagger, nrs->fluid->o_U, o_FS);

  // prevent any numerical drift by subtracting out the volume-average temperature
  const dfloat Tbar =
    platform->linAlg->innerProd(mesh->Nlocal, o_S, mesh->o_Jw, platform->comm.mpiComm()) / mesh->volume;
  platform->linAlg->add(mesh->Nlocal, -Tbar, o_S);
}

void UDF_Setup()
{
  auto mesh = nrs->meshV;

  std::string name;
  setupAide &options = platform->options;
  options.getArgs("RESTART FILE NAME", name);

  // only set initial conditions if there is no restart file
  if (name == "")
  {
    // arbitrary arrays on the host where we will fill some initial data
    std::vector<dfloat> U(nrs->fluid->fieldOffsetSum, 0.0);
    std::vector<dfloat> temp(mesh->Nlocal, 0.0);
    auto [x, y, z] = mesh->xyzHost();

    for (int n = 0; n < mesh->Nlocal; ++n)
    {
      // comment out to see flow if no initial perturbation is applied to the x, y velocity components
      U[n + 0 * nrs->fieldOffset] = 0.2 * std::cos(z[n]); // x-velocity
      U[n + 1 * nrs->fieldOffset] = 0.2 * std::sin(z[n]); // y-velocity

      dfloat r = std::sqrt(x[n] * x[n] + y[n] * y[n]) * 2.0;
      U[n + 2 * nrs->fieldOffset] = -2 * (r * r - 1); // z-velocity
    }

    // copy host data into the device data
    nrs->fluid->o_U.copyFrom(U.data(), U.size());
    nrs->scalar->o_solution("temperature").copyFrom(temp.data(), temp.size());
  }

  // this will call userchk in the fortran file, which does the time averaging
  nek::userchk();

  std::unique_ptr<tavg> avg = std::make_unique<tavg>();
  nrs->scalarSolve->addSource("temperature", userq);
}

