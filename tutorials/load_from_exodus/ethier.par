[GENERAL]
polynomialOrder = 5
stopAt = numSteps
numSteps = 100
dt = 2e-03
timeStepper = tombo3
checkpointControl = steps
checkpointInterval = 5
scalars = temperature, s01

[FLUID PRESSURE]
residualTol = 1e-08

[FLUID VELOCITY]
boundaryTypeMap = udfDirichlet
residualTol = 1e-12
density = 1.0
viscosity = -100

[SCALAR TEMPERATURE]
boundaryTypeMap = udfNeumann
residualTol = 1e-12
transportCoeff = 1.0
diffusionCoeff = -100

[SCALAR S01]
boundaryTypeMap = udfNeumann
residualTol = 1e-12
transportCoeff = 1.0
diffusionCoeff = -100
