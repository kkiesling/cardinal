[GENERAL]
  polynomialOrder = 7
  startFrom = restart.fld
  numSteps = 16000
  dt = 2.0e-4
  timeStepper = tombo2
  checkpointInterval = 2000

  scalars = temperature

  filtering = hpfrt
  filterWeight = 0.1/${dt}
  filterModes = 2

  subCyclingSteps = 2

[FLUID PRESSURE]
  residualTol = 1.0e-4

[FLUID VELOCITY]
  boundaryTypeMap = udfDirichlet, zeroNeumann, zeroDirichlet
  residualTol = 1e-6
  density = 1.0
  viscosity = -4.8e4

[SCALAR TEMPERATURE]
  boundaryTypeMap = udfDirichlet, zeroNeumann, udfNeumann
  transportCoeff = 1.0
  diffusionCoeff = -818400.0
  residualTol = 1.0e-6
